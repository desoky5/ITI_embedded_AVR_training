#include "../LIB/STD_TYPES.h"
#include "../MCAL/DIO/DIO_int.h"
#include <avr/delay.h>

int main()
{
	 MDIO_vInit();
	MDIO_vSetPinDir(DIO_PORTA , DIO_PIN0, DIO_INPUT);//set A0 input
	MDIO_vSetPinVal(DIO_PORTA , DIO_PIN0, DIO_HIGH);
	MDIO_vSetPortDir(DIO_PORTB, DIO_PORT_OUTPUT);
	u8 seven[10]=
	{
			0b00111111,
			0b00000110,
			0b01011011,
			0b01001111,
			0b01100110,
	 0b01101101,
	 0b01111101,
	 0b00000111,
	0b01111111,
			0b01101111,

	};

	u8 index = 0 ;
	while(1)
	{

		if ( MDIO_u8GETPinVal(DIO_PORTA,DIO_PIN0) == 0)
			{
				_delay_ms(100);
				//check again if button is still pressed
				while(MDIO_u8GETPinVal(DIO_PORTA,DIO_PIN0) == 0);
				_delay_ms(20);
				index ++ ;
				 MDIO_vSetPortVal(DIO_PORTB,seven[index]);

			}

	}

return 0;
}



