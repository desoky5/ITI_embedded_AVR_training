#include "../../LIB/STD_TYPES.h"
#include "../../LIB/BIT_MATH.h"
#include "ADC_INT.h"
#include "ADC_prv.h"

void MADC_vInit(void)
{

	//AVCC
	CLEAR_BIT(ADMUX,7);
	SET_BIT(ADMUX,6);

	//RIGHT ADJUSTMENT
	CLEAR_BIT(ADMUX,5);

	//SINGLE CONVERSION MODE

	CLEAR_BIT(ADCSRA,5);

	//PRESCALER
	SET_BIT(ADCSRA,2);
	SET_BIT(ADCSRA,1);
	CLEAR_BIT(ADCSRA,0);

	//Polling
	CLEAR_BIT(ADCSRA,3);

	//ENABLE ADC MUST BE THE LAST INSTRUCTION AFTER FINISHING THE CONFIGURATION OF ADC
	SET_BIT(ADCSRA,7);
}
u16 MADC_vReadAnalog(u8 A_u8Channel)
{
	u8 value ;
	ADMUX = (ADMUX & 0XE0) | (A_u8Channel & 0x07);

	// START CONVERSION
	SET_BIT(ADCSRA,6);
	GET_BIT(ADCSRA,4,value);

	//wait on flag
	while(value == 0 );



	SET_BIT(ADCSRA,4);
return 1;
}


