#include "../../LIB/BIT_MATH.h"
#include "../../LIB/STD_TYPES.h"

#include "GIE_int.h"
#include "GEI_prv.h"



void MGIE_vEnableGlobalInterrupt(void)
{
	SET_BIT(SREG,7);
}
void MGIE_vDisableGlobalInterrupt(void)
{
	CLEAR_BIT(SREG,7);
}
