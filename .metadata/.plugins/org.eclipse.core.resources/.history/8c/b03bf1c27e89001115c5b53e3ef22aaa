#include "../LIB/STD_TYPES.h"
#include "../MCAL/DIO/DIO_int.h"





#include <avr/delay.h>

int main()
{
	MDIO_vSetPinDir(DIO_PORTC , DIO_PIN0, DIO_INPUT);//set A0 input
	MDIO_vSetPinVal(DIO_PORTC , DIO_PIN0, DIO_HIGH);
	MDIO_vSetPinDir( DIO_PORTC , DIO_PIN1, DIO_OUTPUT);//set A1 output

	while(1)
	{
	if ( MDIO_u8GETPinVal(DIO_PORTC,DIO_PIN0) == 0)
	{
		_delay_ms(20);
		//check again if button is still pressed
		if ( MDIO_u8GETPinVal(DIO_PORTC,DIO_PIN0) == 0 )
		{
			MDIO_vTogPinVal(DIO_PORTC,DIO_PIN1);
		}

	}

	}

return 0;
}

