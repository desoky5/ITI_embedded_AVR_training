#ifndef MCAL_EXTI_EXTI_PRV_H_
#define MCAL_EXTI_EXTI_PRV_H_
// Addresses of Register are Extracted from Resister Summary section from ATMEGA32 official Data Sheet
#define MCUCR *((volatile u8*)(0X55)) //MCU CONTROL REGISTER FOR int0 and int1 control (SENSING MODE CONTROL)
#define MCUCSR *((volatile u8*)(0x54)) //MCU CONTROL AND STATUS REGISTER FOR int2 control (SENSING MODE CONTROL)
#define GICR *((volatile u8*)(0X5B)) // GENERAL INTERRUPT CONTROL REGISTEr FOR INT0 , INT1 AND INT2 (( ENABLE  ))
#define GIFR *((volatile u8*)(0X5A)) //GENERAL INTERRUPT FLAG REGISTER THAT HAS FLAGS FOR INT0 , INT1 AND INT2 WHICH ARE RAISED WEHN THE INTERRUPT IN INVOKED

#endif /* MCAL_EXTI_EXTI_PRV_H_ */
